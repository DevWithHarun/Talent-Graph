rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // TEMPORARY MVP rules: authenticated users can access their own data and
    // the platform data needed for the app to work while the project is being
    // matured. This is intentionally permissive to unblock real app workflows.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /athletes/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /club_members/{memberId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /verification_requests/{requestId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /verifications/{verificationId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /notifications/{userId}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
