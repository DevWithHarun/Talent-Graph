rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // TEMPORARY MVP rules: authenticated users can access their own data and
    // the platform data needed for the app to work while the project is being
    // matured. This is intentionally permissive to unblock real app workflows.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Public reads: athlete profiles + club profiles are shareable via link
    // with anyone, including visitors without an account.
    match /athletes/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /performance_metrics/{metricId} {
        allow read: if true;
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      match /growth_milestones/{milestoneId} {
        allow read: if true;
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      match /match_statistics/{matchId} {
        allow read: if true;
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /club_members/{memberId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /verification_requests/{requestId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /verifications/{verificationId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /notifications/{userId}/items/{itemId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /feed_posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /feed_posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /feed_stories/{storyId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.senderId;
    }

    // Guest support: anyone can create a ticket/message without login (via public API).
    // Reads/updates remain restricted to authenticated users (admin/support team).
    match /support_tickets/{ticketId} {
      allow read: if signedIn();
      allow create: if true;
      allow update: if signedIn();
      allow delete: if false;
    }

    match /support_tickets/{ticketId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if true;
      allow update: if signedIn();
      allow delete: if false;
    }

    match /support_tickets/{ticketId}/internalNotes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
